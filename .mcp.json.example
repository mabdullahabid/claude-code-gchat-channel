        "GOOGLE_PRIVATE_KEY": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----",
        "GOOGLE_PROJECT_NUMBER": "123456789",
        "GCHAT_PORT": "8788",
        "GCHAT_ALLOWED_SPACES": ""
      }
    }
  }
}
